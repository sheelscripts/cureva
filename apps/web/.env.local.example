# CureV — Environment Configuration
#
# Copy this file to `.env.local` (Next.js auto-loads files matching that
# pattern; both `apps/web/.env.local` and a repo-root `.env.local` work).
#
# DO NOT COMMIT `.env.local` — it's in `.gitignore` for a reason.

# ─── Supabase ──────────────────────────────────────────────────────
# Public anon key is safe in the browser (RLS-protected).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role bypasses RLS — server-side ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── Vercel AI Gateway (LLM) ───────────────────────────────────────
# One API key (vck_…) routes chat to OpenAI, Anthropic, Meta, Mistral,
# Google, Alibaba, and more. https://vercel.com/dashboard/ai-gateway
AI_GATEWAY_API_KEY=vck-...

# Primary model. The user picked meta/llama-3.2-90b. ⚠️ Region caveat:
# Meta's EULA restricts Llama distribution through Bedrock in some
# countries (India, parts of EU). If you get a 400 "Access to Meta
# Llama models is not allowed from unsupported countries", the client
# will transparently fall back to the model below. Other working
# Meta models on Vercel: meta/llama-3.1-70b, meta/llama-3.3-70b.
AI_GATEWAY_PRIMARY_MODEL=meta/llama-3.2-90b

# Fallback model. meta/llama-3.3-70b works from most regions.
AI_GATEWAY_FALLBACK_MODEL=meta/llama-3.3-70b

# ─── OpenRouter (embeddings) ───────────────────────────────────────
# Vercel AI Gateway rate-limits ALL embedding models on the free tier,
# so embeddings stay on OpenRouter. text-embedding-3-small is paid on
# OpenRouter but very cheap (~$0.02 / 1M tokens). 768 dims to match
# the existing match_documents RPC (vector(768)).
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBED_DIMS=768

# ─── ElevenLabs (voice) ────────────────────────────────────────────
# Used by both the AI scribe (STT) and the voice-call widget (TTS).
# Free tier: ~1h STT / 10k chars TTS per month.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_...

# Optional overrides — defaults are sensible.
# ELEVENLABS_STT_MODEL=scribe_v1
# ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # Rachel

# ─── Resend (email) ────────────────────────────────────────────────
# Optional. If absent, `send_email` returns success:false with a clear
# error and the frontdesk fallback is the WhatsApp deep link.
# Get a free key (100 emails/day): https://resend.com/api-keys
RESEND_API_KEY=re_...

# Override the From address used by sendResendEmail (default: Cureva <notifications@cureva.health>).
# Must be a verified domain in your Resend account.
RESEND_FROM=notifications@your-verified-domain.com

# ─── Observability (Langfuse — optional) ───────────────────────────
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Notification behaviour ────────────────────────────────────────
# Notification delivery is intentionally free-tier:
#   • whatsapp / sms → wa.me / sms: deep link (clicked by frontdesk)
#   • email          → Resend REST API
#
# No Twilio / Meta Cloud API / SIP is wired. If you want to swap in
# real SMS delivery later, see `mcp/notification/notification.ts`.
