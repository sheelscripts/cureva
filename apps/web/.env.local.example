# CureV — Environment Configuration
#
# Copy this file to `.env.local` (Next.js auto-loads files matching that
# pattern; both `apps/web/.env.local` and a repo-root `.env.local` work).
#
# DO NOT COMMIT `.env.local` — it's in `.gitignore` for a reason.

# ─── Supabase ──────────────────────────────────────────────────────
# Public anon key is safe in the browser (RLS-protected).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role bypasses RLS — server-side ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── Google Gemini ─────────────────────────────────────────────────
# Used by all agents (triage, scribe, recovery, prescription) and the
# RAG retriever for embeddings + generation.
GEMINI_API_KEY=AIza...

# ─── Email (Resend) ────────────────────────────────────────────────
# Optional. If absent, `send_email` returns success:false with a clear
# error and the frontdesk fallback is the WhatsApp deep link.
# Get a free key (100 emails/day): https://resend.com/api-keys
RESEND_API_KEY=re_...

# Override the From address used by sendResendEmail (default: Cureva <notifications@cureva.health>).
# Must be a verified domain in your Resend account.
RESEND_FROM=notifications@your-verified-domain.com

# ─── Observability (Langfuse — optional) ───────────────────────────
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Notification behaviour ────────────────────────────────────────
# Notification delivery is intentionally free-tier:
#   • whatsapp / sms → wa.me / sms: deep link (clicked by frontdesk)
#   • email          → Resend REST API
#
# No Twilio / Meta Cloud API / SIP is wired. If you want to swap in
# real SMS delivery later, see `mcp/notification/notification.ts`.
